{
	"name": "dynamically_copy_files",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "dynamic_csv_source_ds",
						"type": "DatasetReference",
						"parameters": {
							"param_source_filename": {
								"value": "@pipeline().parameters.pipeline_param_input_filename",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "dynamic_csv_sink_ds",
						"type": "DatasetReference",
						"parameters": {
							"param_source_filename": {
								"value": "@concat('Processed_',pipeline().parameters.pipeline_param_input_filename)",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"pipeline_param_input_filename": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-14T15:26:38Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}