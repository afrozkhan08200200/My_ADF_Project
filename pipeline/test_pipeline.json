					"expression": {
						"value": "@and(equals(activity('Get Metadata').output.exists,true),\nless(activity('Get Metadata').output.size,1054))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Set variable1",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
