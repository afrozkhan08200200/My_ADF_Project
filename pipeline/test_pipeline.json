							},
							"modifiedDatetimeEnd": {
								"value": "@adddays(utcNow(),2)",
								"type": "Expression"
							},
							"wildcardFileName": "*.csv",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "get_metadata_src",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"pipeline_param_file_name": {
				"type": "string"
			}
		},
		"variables": {
			"is_file_valid": {
				"type": "Boolean"
			}
		},
		"annotations": [],
