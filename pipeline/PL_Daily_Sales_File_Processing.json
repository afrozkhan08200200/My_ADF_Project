{
	"name": "PL_Daily_Sales_File_Processing",
	"properties": {
		"activities": [
			{
				"name": "Get File List",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_source_sales_folder",
						"type": "DatasetReference",
						"parameters": {
							"ds_source_sales_folder": {
								"value": "@pipeline().parameters.pipeline_folder_path",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Set File Count",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Get File List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "var_file_count",
					"value": {
						"value": "@length(activity('Get File List').output.childItems)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check files available",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Set File Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(int(variables('var_file_count')),1)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Check files available",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@createArray('Bangalore','Mumbai','Delhi','Hyderabad')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ExcelSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_excel_sales_file_copy_source",
									"type": "DatasetReference",
									"parameters": {
										"ds_p_file_name": {
											"value": "@pipeline().parameters.pipeline_file_name",
											"type": "Expression"
										},
										"ds_p_folder_path": {
											"value": "@pipeline().parameters.pipeline_folder_path",
											"type": "Expression"
										},
										"ds_p_sheet_name": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_excel_sales_copy_sink",
									"type": "DatasetReference",
									"parameters": {
										"ds_p_output_folder": {
											"value": "@concat('staging/sales/',item(),'/')",
											"type": "Expression"
										},
										"ds_p_output_file": {
											"value": "@concat(item(),'_sales.csv')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"pipeline_folder_path": {
				"type": "string"
			},
			"pipeline_file_name": {
				"type": "string"
			}
		},
		"variables": {
			"var_file_count": {
				"type": "Integer"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-17T18:12:54Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}